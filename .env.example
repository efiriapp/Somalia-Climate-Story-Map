# Copy to .env.local (or set in CI) to override build-time settings.

# Public address of the site, e.g. https://storymap.example.org (no trailing
# slash). Used for share-preview images. Leave empty until the domain is ready.
# VITE_SITE_URL=

# Basemaps. Defaults are free, need no key and allow public use:
# OpenFreeMap (streets), EOX Sentinel-2 cloudless 2016 CC BY 4.0 (satellite),
# AWS Terrain Tiles (hillshade). See src/application/tile-sources.ts.
# VITE_MAP_STYLE_URL=
# VITE_MAP_STYLE_ATTRIBUTION=
# VITE_TILES_SATELLITE_URL=
# VITE_TILES_SATELLITE_ATTRIBUTION=
# VITE_TERRAIN_DEM_URL=
# VITE_TERRAIN_DEM_ATTRIBUTION=
