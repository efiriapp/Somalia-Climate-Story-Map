{
  "name": "somalia-climate-story-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/copy-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node ./scripts/copy-maplibre-worker.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "images:optimize": "node ./scripts/optimize-images.mjs",
    "images:check": "node ./scripts/optimize-images.mjs --check",
    "package": "npm run build && node ./scripts/package-site.mjs",
    "credits:fetch": "node ./scripts/fetch-wikimedia-credits.mjs",
    "media:report": "vite-node scripts/media-report.ts",
    "videos:fetch": "node ./scripts/fetch-video-metadata.mjs",
    "watch:baselines": "node ./scripts/fetch-watch-baselines.mjs",
    "data:prepare": "node --max-old-space-size=8192 ./scripts/prepare-watch-data.mjs && npm run -s data:areas",
    "data:areas": "node --max-old-space-size=8192 ./scripts/flood-areas.mjs",
    "data:forest": "node --max-old-space-size=8192 ./scripts/forest-loss.mjs",
    "data:charcoal": "node ./scripts/charcoal-areas.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/noto-sans-arabic": "^5.2.6",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "flag-icons": "^7.5.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "mapshaper": "^0.7.101",
    "sharp": "^0.34.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
